{
  "name": "tpsms-backend",
  "version": "1.0.0",
  "description": "Transport Payment Slip Management System - Backend API (Express + Google Sheets store)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "sheets:configure": "tsx src/scripts/configureSheets.ts",
    "sheets:migrate": "tsx src/scripts/migrateToSheets.ts",
    "sheets:verify": "tsx src/scripts/verifySheets.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "transport",
    "payment-slip",
    "express",
    "google-sheets"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
