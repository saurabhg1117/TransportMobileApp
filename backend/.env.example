# ---- Server ----
PORT=5000

# ---- CORS (production) ----
# Comma-separated frontend URLs allowed to call the API. Leave empty to allow all.
# CORS_ORIGIN=https://your-app.netlify.app

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ---- Session ----
# Idle session timeout hint (minutes) returned to clients. 0 = disabled.
SESSION_TIMEOUT_MINUTES=60

# ---- Super Admin (used by `npm run seed`) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123

# ---- Data store ----
# When the three GOOGLE_* values below are all set, data is stored in Google Sheets.
# Otherwise the backend falls back to a local JSON file (DATA_FILE) so you can run it immediately.
DATA_FILE=data/transport-data.json

# ---- Google Sheets (primary store) ----
# 1. Create a Google Cloud service account and enable the Google Sheets API.
# 2. Create a spreadsheet, share it with the service account email (Editor).
# 3. Put the spreadsheet id (from its URL) here.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Option A (recommended on Belmo): base64-encoded service-account JSON (single line).
# Run: npx tsx src/scripts/printHostingEnv.ts path/to/key.json
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Option B: paste the ENTIRE service-account JSON file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: separate fields (local .env)
GOOGLE_PRIVATE_KEY=
